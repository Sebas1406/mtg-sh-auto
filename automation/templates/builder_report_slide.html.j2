<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=1080, initial-scale=1">
  <title>{{ slide.filename }}</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; }
    body {
      color: {{ theme.ink }};
      font-family: Georgia, "Times New Roman", serif;
      background:
        radial-gradient(circle at 50% 5%, rgba(255,235,191,.18), transparent 34%),
        linear-gradient(90deg, rgba(30,15,8,.22), transparent 8%, transparent 92%, rgba(30,15,8,.22)),
        repeating-linear-gradient(90deg, transparent 0 118px, rgba(255,255,255,.025) 118px 121px),
        linear-gradient(180deg, {{ theme.deep }}, {{ theme.wood }} 48%, {{ theme.deep }});
    }
    .page {
      position: relative;
      width: 1080px;
      height: 1920px;
      padding: 92px 74px 112px;
    }
    .paper {
      position: absolute;
      inset: 54px 42px 66px;
      border: 2px solid rgba(255,255,255,.16);
      border-radius: 30px;
      background:
        radial-gradient(circle at 15% 18%, rgba(255,255,255,.36), transparent 34%),
        repeating-linear-gradient(0deg, rgba(84,57,29,.025) 0 1px, transparent 1px 7px),
        linear-gradient(160deg, {{ theme.paper_light }}, {{ theme.paper }});
      box-shadow: 0 28px 70px rgba(0,0,0,.34), inset 0 0 70px rgba(104,69,32,.09);
    }
    .content { position: relative; height: 100%; z-index: 2; }
    .eyebrow {
      margin-top: 14px;
      color: {{ theme.accent }};
      font: 700 25px/1.1 Arial, sans-serif;
      letter-spacing: 4px;
      text-align: center;
    }
    h1 {
      margin: 20px auto 8px;
      max-width: 900px;
      color: {{ theme.deep }};
      font-size: 58px;
      line-height: .98;
      text-align: center;
      letter-spacing: -1.5px;
    }
    .rule {
      width: 210px;
      height: 7px;
      margin: 24px auto;
      border-radius: 99px;
      background: {{ theme.accent }};
    }
    .subtitle, .promise {
      max-width: 820px;
      margin: 0 auto;
      color: {{ theme.muted }};
      font: 24px/1.35 Arial, sans-serif;
      text-align: center;
    }
    .footer {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 14px;
      color: {{ theme.deep }};
      font: 700 23px/1 Arial, sans-serif;
      letter-spacing: 1px;
      text-align: center;
    }

    /* Cover */
    .cover h1 { font-size: 66px; max-width: 870px; }
    .cover-art {
      position: relative;
      width: 530px;
      height: 738px;
      margin: 46px auto 30px;
    }
    .cover-art::before {
      content: "";
      position: absolute;
      inset: -18px;
      border: 4px solid {{ theme.accent }};
      border-radius: 25px;
      opacity: .7;
      transform: rotate(-1.2deg);
    }
    .cover-art img { position: relative; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 16px 18px rgba(0,0,0,.25)); }
    .cover-art.pair { width: 650px; height: 650px; margin-top: 30px; }
    .cover-art.pair::before { inset: 24px 0 -4px; }
    .cover-art.pair img { position: absolute; top: 42px; width: 410px; height: 570px; }
    .cover-art.pair img:first-child { left: 12px; transform: rotate(-4deg); }
    .cover-art.pair img:last-child { right: 12px; transform: rotate(4deg); }
    .badge {
      width: fit-content;
      margin: 0 auto 26px;
      padding: 12px 20px;
      border-radius: 999px;
      color: white;
      background: {{ theme.success }};
      font: 800 20px/1 Arial, sans-serif;
      letter-spacing: 2px;
    }
    .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 34px 56px 0; }
    .metric { padding: 17px 8px 15px; border: 1px solid rgba(69,42,22,.14); border-radius: 15px; background: rgba(255,255,255,.42); text-align: center; }
    .metric-value { color: {{ theme.deep }}; font: 800 35px/1 Arial, sans-serif; }
    .metric-label { margin-top: 8px; color: {{ theme.muted }}; font: 700 14px/1 Arial, sans-serif; letter-spacing: 1.5px; }

    /* Skeleton */
    .stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin: 38px 74px 28px; }
    .stat-box { min-height: 126px; padding: 22px 25px; border-left: 8px solid {{ theme.accent }}; border-radius: 16px; background: rgba(255,255,255,.55); box-shadow: 0 8px 22px rgba(75,44,20,.08); }
    .stat-value { color: {{ theme.deep }}; font: 800 48px/1 Arial, sans-serif; }
    .stat-label { margin-top: 13px; color: {{ theme.muted }}; font: 700 17px/1.1 Arial, sans-serif; letter-spacing: 1.4px; }
    .curve-card { margin: 24px 74px; padding: 24px 32px 20px; border-radius: 18px; background: rgba(55,33,19,.92); color: {{ theme.cream }}; }
    .curve-title { font: 700 20px Arial, sans-serif; letter-spacing: 2px; }
    .curve { display: flex; height: 210px; align-items: flex-end; gap: 22px; margin-top: 20px; }
    .bar-wrap { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; text-align: center; }
    .bar { width: 100%; min-height: 10px; border-radius: 8px 8px 2px 2px; background: {{ theme.accent }}; }
    .bar-count { margin: 8px 0 5px; font: 700 18px Arial, sans-serif; }
    .bar-label { color: #d7c4a5; font: 15px Arial, sans-serif; }
    .checks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 22px; margin: 22px 82px; }
    .check { color: {{ theme.deep }}; font: 700 19px/1.25 Arial, sans-serif; }
    .check::before { content: "✓"; display: inline-block; margin-right: 10px; color: {{ theme.success }}; }

    /* Feature package */
    .feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 24px; margin: 34px 62px 0; }
    .feature-card { min-height: 652px; padding: 17px 16px 20px; border: 1px solid rgba(69,42,22,.16); border-radius: 20px; background: rgba(255,255,255,.52); box-shadow: 0 10px 24px rgba(75,44,20,.11); }
    .image-wrap { position: relative; width: 270px; height: 376px; margin: 0 auto 14px; }
    .image-wrap img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 8px 8px rgba(0,0,0,.18)); }
    .tag { position: absolute; left: 50%; bottom: 3px; transform: translateX(-50%); padding: 7px 11px; border-radius: 999px; color: white; background: {{ theme.accent }}; font: 800 13px/1 Arial, sans-serif; letter-spacing: 1px; white-space: nowrap; }
    .card-name { min-height: 52px; color: {{ theme.deep }}; font-size: 23px; font-weight: 700; line-height: 1.08; text-align: center; }
    .reason { margin-top: 9px; color: {{ theme.muted }}; font: 18px/1.3 Arial, sans-serif; text-align: center; }
    .cta { width: fit-content; margin: 28px auto 0; padding: 12px 18px; border-radius: 12px; color: {{ theme.cream }}; background: {{ theme.deep }}; font: 700 18px/1.2 Arial, sans-serif; text-align: center; }
  </style>
</head>
<body>
  <div class="page {{ slide.kind }}">
    <div class="paper"></div>
    <div class="content">
      <div class="eyebrow">{{ slide.eyebrow }}</div>
      <h1>{{ slide.title }}</h1>
      <div class="rule"></div>

      {% if slide.kind == "cover" %}
        <div class="promise">{{ slide.promise }}</div>
        <div class="cover-art {% if slide.paired_commanders %}pair{% endif %}">{% for image_url in slide.commander_card_urls %}<img src="{{ image_url }}" alt="{{ commander_name }}">{% endfor %}</div>
        <div class="badge">✓ {{ slide.badge }}</div>
        <div class="metrics">
          {% for metric in slide.metrics %}
            <div class="metric"><div class="metric-value">{{ metric.value }}</div><div class="metric-label">{{ metric.label }}</div></div>
          {% endfor %}
        </div>
      {% elif slide.kind == "skeleton" %}
        <div class="subtitle">{{ slide.subtitle }}</div>
        <div class="stat-grid">
          {% for stat in slide.stats %}
            <div class="stat-box"><div class="stat-value">{{ stat.value }}</div><div class="stat-label">{{ stat.label }}</div></div>
          {% endfor %}
        </div>
        <div class="curve-card">
          <div class="curve-title">NONLAND MANA CURVE</div>
          <div class="curve">
            {% for point in slide.curve %}
              <div class="bar-wrap"><div class="bar" style="height: {{ point.percent }}%"></div><div class="bar-count">{{ point.count }}</div><div class="bar-label">{{ point.label }}</div></div>
            {% endfor %}
          </div>
        </div>
        <div class="checks">{% for line in slide.validation_lines %}<div class="check">{{ line }}</div>{% endfor %}</div>
      {% else %}
        <div class="subtitle">{{ slide.subtitle }}</div>
        <div class="feature-grid">
          {% for card in slide.cards %}
            <div class="feature-card">
              <div class="image-wrap"><img src="{{ card.image_url }}" alt="{{ card.name }}"><div class="tag">{{ card.tag }}</div></div>
              <div class="card-name">{{ card.name }}</div>
              <div class="reason">{{ card.reason }}</div>
            </div>
          {% endfor %}
        </div>
        {% if slide.cta %}<div class="cta">{{ slide.cta }}</div>{% endif %}
      {% endif %}
      <div class="footer">{{ footer_handle }}</div>
    </div>
  </div>
</body>
</html>
